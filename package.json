{
  "name": "shoplite",
  "version": "1.0.0",
  "private": true,
  "description": "ShopLite: a Next.js store with the UI and the API on one port, backed by an in-memory SQLite database",
  "engines": {
    "node": ">=16.14"
  },
  "scripts": {
    "start": "node custom-start.js",
    "test": "jest --testPathPattern=_main",
    "test:hidden": "jest --testPathPattern=_hidden --runInBand --ci --reporters=./src/tests/test-reporter/index.js"
  },
  "dependencies": {
    "next": "13.5.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.8",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0"
  }
}
